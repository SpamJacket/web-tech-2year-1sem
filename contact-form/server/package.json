        "express-validator": "^7.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/express": "^5.0.6",
        "@types/node": "^25.0.2",
        "eslint": "^9.39.1",
        "globals": "^16.5.0",
        "nodemon": "^3.1.11",
        "prettier": "^3.7.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.4"
    }
